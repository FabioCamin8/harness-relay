{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FabioCamin8/harness-relay/result.schema.json",
  "title": "HarnessRelay normalized native task result",
  "$defs": {
    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["started", "completed", "exit_code", "classification"],
      "properties": {
        "started": {"type": "boolean"},
        "completed": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]},
        "classification": {"type": "string", "enum": ["completed", "failed", "timeout", "canceled", "executable_missing", "spawn_error"]}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "path", "old_path"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "old_path": {"type": ["string", "null"]}
      }
    },
    "git_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["head", "committed_delta", "staged", "staged_changes", "unstaged", "unstaged_changes", "untracked", "untracked_files", "status", "clean"],
      "properties": {
        "head": {"type": "string", "minLength": 1},
        "committed_delta": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "staged": {"type": "boolean"},
        "staged_changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "unstaged": {"type": "boolean"},
        "unstaged_changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "untracked": {"type": "boolean"},
        "untracked_files": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "clean": {"type": "boolean"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["result_schema_version", "run", "process", "native", "invocation", "validation", "acceptance", "git", "evidence"],
  "properties": {
    "result_schema_version": {"type": "integer", "const": 1},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "worker", "worker_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "worker": {"type": "string", "enum": ["codex", "claude", "agy", "opencode"]},
        "worker_version": {"type": "string", "minLength": 1}
      }
    },
    "process": {
      "$ref": "#/$defs/process"
    },
    "native": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "structured", "summary", "claims"],
      "properties": {
        "outcome": {"type": "string", "enum": ["success", "failure", "auth_required", "tool_denied", "canceled", "interrupted", "invalid", "running", "empty_output", "malformed_output", "timeout", "unknown"]},
        "structured": {"type": "boolean"},
        "summary": {"type": ["string", "null"]},
        "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"const": "worker_claim"}, "text": {"type": "string"}}}}
      }
    },
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["executed", "outcome", "process", "argv", "stdout", "stderr"],
      "properties": {
        "executed": {"type": "boolean"},
        "outcome": {"type": "string", "enum": ["not_run", "passed", "failed", "error", "timeout", "canceled"]},
        "process": {"anyOf": [{"$ref": "#/$defs/process"}, {"type": "null"}]},
        "argv": {"type": ["array", "null"], "items": {"type": "string"}},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "independent", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["not_checked", "passed", "failed"]},
        "independent": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "base", "after_worker", "after_validation", "errors"],
      "properties": {
        "repository": {"type": "boolean"},
        "base": {"type": ["string", "null"]},
        "after_worker": {"anyOf": [{"$ref": "#/$defs/git_snapshot"}, {"type": "null"}]},
        "after_validation": {"anyOf": [{"$ref": "#/$defs/git_snapshot"}, {"type": "null"}]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["stdout", "stderr", "events", "parse_error"],
      "properties": {
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "events": {"type": "array", "items": {"type": "object"}},
        "parse_error": {"type": ["string", "null"]}
      }
    }
  }
}
